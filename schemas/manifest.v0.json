{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mbcp.dev/schemas/manifest.v0.json",
  "title": "MBCP profile manifest (v0)",
  "description": "Top-level bundle manifest: bundle id, profile version, records, tombstones. Record and tombstone definitions are inlined in $defs so this schema is self-contained.",
  "type": "object",
  "required": [
    "bundle",
    "mbcp_version",
    "records",
    "tombstones"
  ],
  "additionalProperties": false,
  "properties": {
    "bundle": {
      "type": "object",
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "mbcp_version": {
      "type": "string",
      "pattern": "^0\\.1$"
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    },
    "tombstones": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/tombstone"
      }
    }
  },
  "$defs": {
    "record": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "body",
        "scope",
        "time",
        "lifecycle",
        "provenance",
        "consent",
        "integrity",
        "mbcp"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "body": {
          "type": "string"
        },
        "scope": {
          "type": "object",
          "required": [
            "owner"
          ],
          "additionalProperties": true,
          "properties": {
            "owner": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "time": {
          "type": "object",
          "required": [
            "created"
          ],
          "additionalProperties": false,
          "properties": {
            "created": {
              "type": "string",
              "format": "date-time"
            },
            "updated": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "lifecycle": {
          "enum": [
            "active",
            "archived",
            "deleted"
          ]
        },
        "provenance": {
          "type": "object",
          "required": [
            "source"
          ],
          "additionalProperties": true,
          "properties": {
            "source": {
              "type": "string",
              "minLength": 1
            },
            "generated_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "consent": {
          "type": "object",
          "required": [
            "exportable"
          ],
          "additionalProperties": false,
          "properties": {
            "retention": {
              "type": "string"
            },
            "exportable": {
              "type": "boolean"
            },
            "redact": {
              "type": "boolean"
            }
          }
        },
        "integrity": {
          "type": "object",
          "required": [
            "algo",
            "digest"
          ],
          "additionalProperties": false,
          "properties": {
            "algo": {
              "enum": [
                "sha256"
              ]
            },
            "digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "truncated": {
              "type": "boolean",
              "description": "Set true by the loader when on_budget_exceed=truncate_last cut the body; digest is re-computed over the truncated body."
            }
          }
        },
        "mbcp": {
          "type": "object",
          "required": [
            "load_policy"
          ],
          "additionalProperties": false,
          "properties": {
            "load_policy": {
              "type": "object",
              "required": [
                "priority",
                "max_chars",
                "on_budget_exceed",
                "merge"
              ],
              "additionalProperties": false,
              "properties": {
                "priority": {
                  "enum": [
                    "critical",
                    "standard",
                    "opportunistic"
                  ]
                },
                "max_chars": {
                  "type": "integer",
                  "minimum": 0
                },
                "on_budget_exceed": {
                  "enum": [
                    "truncate_last",
                    "skip",
                    "error"
                  ]
                },
                "merge": {
                  "enum": [
                    "append_first_wins",
                    "append_last_wins",
                    "error_on_conflict"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "tombstone": {
      "type": "object",
      "required": [
        "target_id",
        "deleted_at",
        "reason",
        "derived_artifacts"
      ],
      "additionalProperties": false,
      "properties": {
        "target_id": {
          "type": "string",
          "minLength": 1
        },
        "deleted_at": {
          "type": "string",
          "format": "date-time"
        },
        "reason": {
          "type": "string"
        },
        "derived_artifacts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
