{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mbcp.dev/schemas/bundle-record.v0.json",
  "title": "MBCP bundle record (v0)",
  "description": "Single memory record inside an MBCP bundle. Shape inherits UMP (kind/body/scope/time/lifecycle/provenance/consent/integrity); the mbcp extension adds cross-bundle load_policy.",
  "type": "object",
  "required": [
    "id",
    "kind",
    "body",
    "scope",
    "time",
    "lifecycle",
    "provenance",
    "consent",
    "integrity",
    "mbcp"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]{1,128}$",
      "description": "Record id grammar (SPEC 1.5 v0.1-audit-12 tightening): safe characters only, max 128; '..' is additionally rejected in code (validate_record / check_record_on_load) since the minimal validator has no 'not' keyword. The class additionally permits ':' for the shipped importers' prefixed ids (e.g. 'chatgpt:<conversation-id>') - documented Round C1 judgment call pending an importer id-scheme migration."
    },
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "body": {
      "type": "string"
    },
    "scope": {
      "type": "object",
      "required": [
        "owner"
      ],
      "additionalProperties": true,
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "time": {
      "type": "object",
      "required": [
        "created"
      ],
      "additionalProperties": false,
      "properties": {
        "created": {
          "type": "string",
          "format": "date-time"
        },
        "updated": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "lifecycle": {
      "enum": [
        "active",
        "archived",
        "deleted"
      ]
    },
    "provenance": {
      "type": "object",
      "required": [
        "source"
      ],
      "additionalProperties": true,
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "sensitivity": {
          "type": "string",
          "enum": [
            "public",
            "internal",
            "sensitive",
            "secret"
          ],
          "description": "Isaac ruling 2026-11-06 (BACKLOG M2 #6): the sensitivity vocabulary is exactly {public, internal, sensitive, secret}. Optional; records without the field stay valid. Invariant enforced on the build path: sensitivity='secret' must not be combined with consent.exportable=true."
        }
      }
    },
    "consent": {
      "type": "object",
      "required": [
        "exportable"
      ],
      "additionalProperties": false,
      "properties": {
        "retention": {
          "type": "string"
        },
        "exportable": {
          "type": "boolean"
        },
        "redact": {
          "type": "boolean"
        }
      }
    },
    "integrity": {
      "type": "object",
      "required": [
        "algo",
        "digest"
      ],
      "additionalProperties": false,
      "properties": {
        "algo": {
          "enum": [
            "sha256"
          ]
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "truncated": {
          "type": "boolean",
          "description": "Set true by the loader when on_budget_exceed=truncate_last cut the body; digest is re-computed over the truncated body."
        }
      }
    },
    "mbcp": {
      "type": "object",
      "required": [
        "load_policy"
      ],
      "additionalProperties": false,
      "properties": {
        "load_policy": {
          "type": "object",
          "required": [
            "priority",
            "max_chars",
            "on_budget_exceed",
            "merge"
          ],
          "additionalProperties": false,
          "properties": {
            "priority": {
              "enum": [
                "critical",
                "standard",
                "opportunistic"
              ]
            },
            "max_chars": {
              "type": "integer",
              "minimum": 1,
              "description": "Class budget floor: minimum 1 (SPEC 1.5 v0.1-audit-8 tightening) - 0 would zero out the whole priority class."
            },
            "on_budget_exceed": {
              "enum": [
                "truncate_last",
                "skip",
                "error"
              ]
            },
            "merge": {
              "enum": [
                "append_first_wins",
                "append_last_wins",
                "error_on_conflict"
              ]
            }
          }
        }
      }
    }
  }
}
